#!/bin/bash

source -- "library/base" || exit 1

(( $# == 0 )) && exit 1

directory="$1"
! [[ -d "$directory" ]] && exit 1

if git -C "$directory" rev-parse --is-inside-work-tree >"/dev/null" 2>&1; then
    exit 0
fi
if GIT_DIR="$directory" git rev-parse --git-dir >"/dev/null" 2>&1; then
    exit 0
fi

exit 1
